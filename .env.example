# Public origin used by SEO metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Persistent volume, not a stateless/serverless filesystem.
DATA_DIR=./data

# Social-only authentication. Leave unset until real provider apps are registered.
# Must match the browser's public origin; HTTPS required in production and for Apple.
# OAUTH_SITE_URL=https://your-domain.example
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=
# Apple client ID is a Services ID; client secret is an ES256-signed JWT, not the .p8 key.
# OAUTH_APPLE_CLIENT_ID=
# OAUTH_APPLE_CLIENT_SECRET=
# OAUTH_MICROSOFT_CLIENT_ID=
# OAUTH_MICROSOFT_CLIENT_SECRET=
# common supports organizational and personal accounts if enabled in the Microsoft app.
# OAUTH_MICROSOFT_TENANT_ID=common

# Operator-only CLI; set in the shell, never in browser-facing variables.
# ADMIN_USER_ID=<existing-social-user-id>

# Server-side duration validation uses a maintained FFprobe installed on the host.
# Defaults to ffprobe on PATH; optionally set its absolute executable path.
# FFPROBE_PATH=/usr/bin/ffprobe

# Only if a trusted reverse proxy rewrites Host: exact backend host, no wildcard.
# OAUTH_PROXY_HOST=internal-preview-host.example
